# Hostinger clona el repositorio completo en la carpeta del subdominio.
# Esto hace que el subdominio sirva solo lo que está en app/
# y que no se puedan abrir los demás archivos (schema.sql, CLAUDE.md, .git, etc.).
RewriteEngine On
# Ligas limpias para registrar canciones: /cancion/<ministerio> abre el formulario (app/cancion/index.html)
RewriteRule ^cancion/([a-z0-9-]+)/?$ app/cancion/index.html [L]
RewriteCond %{REQUEST_URI} !^/app/
RewriteRule ^(.*)$ app/$1 [L]

# Que el navegador siempre pregunte por la versión nueva de la app después de cada despliegue
<IfModule mod_headers.c>
  # La Bitácora y sus formularios (entrada/, cancion/) son privados: que ningún buscador los indexe
  Header set X-Robots-Tag "noindex, nofollow, noarchive"
  <FilesMatch "\.(html|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
